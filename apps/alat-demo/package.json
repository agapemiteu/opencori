  "dependencies": {
    "@corri/contracts": "workspace:*",
    "@corri/sdk": "workspace:*"
  },
  "devDependencies": {
    "@corri/config-verifier": "workspace:*",
    "@corri/crypto-envelope": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
