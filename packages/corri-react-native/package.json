{
  "name": "@corri/sdk",
  "version": "0.12.3",
  "description": "Privacy-first branch presence and encrypted-delivery SDK for host applications",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "corri",
    "geofencing",
    "branch-presence",
    "react-native",
    "encrypted-delivery",
    "privacy"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "eslint src test",
    "prepack": "pnpm --filter @corri/sdk... run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@corri/contracts": "workspace:*",
    "@corri/config-verifier": "workspace:*",
    "@corri/crypto-envelope": "workspace:*",
    "@corri/geofence-state-machine": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
