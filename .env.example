# --- apps/control-api ---
CORRI_HOST=0.0.0.0
CORRI_PORT=3000
CORRI_SERVICE_VERSION=0.0.0
CORRI_CORS_ORIGINS=http://localhost:3002
NODE_ENV=development
WEMA_DEMO_WEBHOOK_URL=http://127.0.0.1:3001/v1/wema/deliveries
# How long Corri waits for the receiver to answer, in milliseconds. Raise this
# on hosts that suspend idle services, or the first delivery after an idle
# period aborts and the customer sees a 503.
WEMA_DEMO_WEBHOOK_TIMEOUT_MS=10000
# Retries if the receiver refuses the call. Leave at 0 locally. Raise it on
# hosts that suspend idle services, so a waking receiver still gets the message.
WEMA_DEMO_WEBHOOK_RETRIES=0
WEMA_DEMO_WEBHOOK_RETRY_DELAY_MS=2000

# --- apps/alat-demo ---
# Every value below has a working localhost default. Set them only when the
# demo runs against a deployed control-api, for example on Vercel.
NEXT_PUBLIC_CORRI_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CORRI_APP_KEY=demo-app-key
# The demo warms this URL on page load, so the receiver is already up by the
# time a send reaches it. Point it at any cheap GET on the receiver. Leave it
# unset locally, where nothing sleeps.
NEXT_PUBLIC_RECEIVER_WARMUP_URL=

# Receiver encryption keypair the host app encrypts to. The public half is
# served by the control-api demo catalog; paste the PEM here to pin it.
NEXT_PUBLIC_RECEIVER_KEY_ID=receiver-test-key
NEXT_PUBLIC_RECEIVER_PUBLIC_KEY=

# Signing key the host app uses to verify tenant configuration.
NEXT_PUBLIC_CONFIG_SIGNING_KEY_ID=wema-test-config-key
NEXT_PUBLIC_CONFIG_SIGNING_PUBLIC_KEY=
